# Dependency directories (โฟลเดอร์เก็บไลบรารีที่ห้ามอัปโหลดเด็ดขาด)
node_modules/
jspm_packages/
web_modules/

# Logs (ไฟล์บันทึกประวัติการทำงาน/ข้อผิดพลาด)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data (ข้อมูลการทำงานระบบ)
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt & Gulp build folders
.grunt/
.gulp/

# Bower dependency directory
bower_components

# node-gyp compilation folder
build/Release

# IDEs and editors (ไฟล์ตั้งค่าของโปรแกรมเขียนโค้ด)
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files (ไฟล์ขยะของระบบปฏิบัติการ)
.DS_Store
Thumbs.db

# Environmental variables (ไฟล์เก็บความลับ เช่น รหัสผ่าน, API Key)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# TypeScript output (ถ้าคุณใช้ TypeScript และไม่ต้องการอัปโหลดไฟล์ที่ Compile แล้ว)
# dist/
# out/
